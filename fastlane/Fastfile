require "shellwords"

fastlane_version "2.228.0"
default_platform(:ios)

PROJECT = "CICDPipelinePOC.xcodeproj"
APP_SCHEME = "CICDPipelinePOC"
CI_TEST_SCHEME = "CICDPipelinePOCCI"
UNIT_TEST_TARGET = "CICDPipelinePOCTests"
SIMULATOR_DEVICE = ENV.fetch("SIMULATOR_DEVICE", "iPhone 16e")
SIMULATOR_OS = ENV.fetch("SIMULATOR_OS", "").strip


def ci_metadata_xcargs
  values = {
    "CI_COMMIT_SHA" => ENV.fetch("CI_COMMIT_SHA", "local"),
    "CI_BRANCH" => ENV.fetch("CI_BRANCH", "local"),
    "CI_WORKFLOW" => ENV.fetch("CI_WORKFLOW", "Xcode"),
    "CI_RUN_NUMBER" => ENV.fetch("CI_RUN_NUMBER", "local"),
    "CI_BUILD_DATE" => ENV.fetch("CI_BUILD_DATE", "local"),
    "CI_ENVIRONMENT" => ENV.fetch("CI_ENVIRONMENT", "Local Development")
  }

  values.map { |key, value| "#{key}=#{Shellwords.escape(value)}" }.join(" ")
end


def app_store_connect_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_CONTENT"),
    is_key_content_base64: true
  )
end


def testflight_changelog(build_number)
  release_notes_path = ENV.fetch("RELEASE_NOTES_PATH", "build/release_notes.txt")
  changelog = if File.exist?(release_notes_path)
                File.read(release_notes_path, encoding: "UTF-8").strip
              else
                "Automated GitHub Actions build #{build_number}"
              end

  UI.user_error!("TestFlight release notes are empty.") if changelog.empty?
  changelog
end


def localized_testflight_build_info(changelog)
  {
    "default" => {
      whats_new: changelog
    }
  }
end


platform :ios do
  desc "Run unit tests only with code coverage"
  lane :test do
    # Use the runner's default Xcode. The workflow may still contain an older
    # DEVELOPER_DIR value while a PR is being updated, so remove that override.
    ENV.delete("DEVELOPER_DIR")

    test_device = if SIMULATOR_OS.empty?
                    SIMULATOR_DEVICE
                  else
                    "#{SIMULATOR_DEVICE} (#{SIMULATOR_OS})"
                  end

    test_options = {
      project: PROJECT,
      scheme: CI_TEST_SCHEME,
      devices: [test_device],
      ensure_devices_found: true,
      clean: true,
      only_testing: [UNIT_TEST_TARGET],
      code_coverage: true,
      result_bundle: true,
      output_directory: "fastlane/test_output",
      buildlog_path: "fastlane/test_output/buildlogs",
      output_types: "junit,html",
      output_files: "junit.xml,report.html",
      xcargs: ci_metadata_xcargs
    }

    unless SIMULATOR_OS.empty?
      test_options[:sdk] = "iphonesimulator#{SIMULATOR_OS}"
      test_options[:deployment_target_version] = SIMULATOR_OS
    end

    run_tests(**test_options)
  end

  desc "Build, sign, upload, and publish What to Test in TestFlight"
  lane :beta do
    ENV.delete("DEVELOPER_DIR")

    app_identifier = ENV.fetch("APP_IDENTIFIER")
    app_version = ENV.fetch("APP_VERSION")
    team_id = ENV.fetch("APPLE_TEAM_ID")
    profile_name = ENV.fetch("PROVISIONING_PROFILE_NAME")
    build_number = ENV.fetch("CI_BUILD_NUMBER")
    changelog = testflight_changelog(build_number)
    api_key = app_store_connect_key

    UI.message("TestFlight What to Test for #{app_version} (#{build_number}):\n#{changelog}")

    increment_build_number(
      xcodeproj: PROJECT,
      build_number: build_number
    )

    signing_arguments = [
      ci_metadata_xcargs,
      "CODE_SIGN_STYLE=Manual",
      "DEVELOPMENT_TEAM=#{Shellwords.escape(team_id)}",
      "PROVISIONING_PROFILE_SPECIFIER=#{Shellwords.escape(profile_name)}",
      "CODE_SIGN_IDENTITY=#{Shellwords.escape('Apple Distribution')}"
    ].join(" ")

    build_app(
      project: PROJECT,
      scheme: APP_SCHEME,
      configuration: "Release",
      clean: true,
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { app_identifier => profile_name }
      },
      xcargs: signing_arguments,
      output_directory: "build",
      output_name: "#{APP_SCHEME}.ipa"
    )

    upload_to_testflight(
      api_key: api_key,
      app_identifier: app_identifier,
      app_version: app_version,
      build_number: build_number,
      ipa: "build/#{APP_SCHEME}.ipa",
      changelog: changelog,
      localized_build_info: localized_testflight_build_info(changelog),
      distribute_external: false,
      notify_external_testers: false,
      submit_beta_review: false,
      skip_waiting_for_build_processing: false,
      wait_processing_interval: 30,
      wait_processing_timeout_duration: 1800
    )

    UI.success("TestFlight build and What to Test metadata were published.")
  end

  desc "Repair What to Test metadata for an existing TestFlight build"
  lane :repair_testflight_notes do
    app_identifier = ENV.fetch("APP_IDENTIFIER")
    app_version = ENV.fetch("APP_VERSION")
    build_number = ENV.fetch("CI_BUILD_NUMBER")
    changelog = testflight_changelog(build_number)

    UI.message("Repairing TestFlight What to Test for #{app_version} (#{build_number}):\n#{changelog}")

    upload_to_testflight(
      api_key: app_store_connect_key,
      app_identifier: app_identifier,
      app_version: app_version,
      build_number: build_number,
      distribute_only: true,
      changelog: changelog,
      localized_build_info: localized_testflight_build_info(changelog),
      distribute_external: false,
      notify_external_testers: false,
      submit_beta_review: false,
      skip_waiting_for_build_processing: false,
      wait_processing_interval: 30,
      wait_processing_timeout_duration: 1800
    )

    UI.success("What to Test metadata was updated for the existing TestFlight build.")
  end

  error do |lane, exception|
    if [:beta, :repair_testflight_notes].include?(lane)
      UI.error("TestFlight build metadata could not be updated.")
      UI.error("Confirm that the App Store Connect API key has App Manager or Admin access.")
    end
    raise exception
  end
end
